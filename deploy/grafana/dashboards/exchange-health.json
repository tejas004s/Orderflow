{
  "uid": "orderflow-health",
  "title": "OrderFlow Exchange Health",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Orders Processed / sec (by Status)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(orderflow_orders_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Matching Engine Latency (p50 / p99)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(orderflow_match_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(orderflow_match_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Trades Executed / sec (by Symbol)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (symbol) (rate(orderflow_trades_executed_total[1m]))",
          "legendFormat": "{{symbol}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active WebSocket Connections",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(orderflow_ws_connections)",
          "legendFormat": "WS Clients"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Latest Outbox Batch Size",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max(orderflow_outbox_published_batch_size)",
          "legendFormat": "Batch"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Gateway HTTP Request p99 Latency",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(orderflow_http_request_duration_seconds_bucket[1m])) by (le, method))",
          "legendFormat": "{{method}} p99"
        }
      ]
    }
  ]
}
